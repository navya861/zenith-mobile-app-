    "name": "Zenith '26 Fest Management System API",
    "description": "Postman API Collection for Zenith '26 College Fest Management System (PM2-01 & PM2-02). Tests event queries, server-side registration validation, live capacity computation, and admin stats.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Events",
      "item": [
        {
          "name": "1. GET All Events (with Query Params)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technical&search=Code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "category",
                  "value": "Technical",
                  "description": "Filter by category (Technical, Cultural, Sports, Gaming, Workshop)"
                },
                {
                  "key": "search",
                  "value": "Code",
                  "description": "Case-insensitive title search keyword"
                }
              ]
            },
            "description": "Fetches filtered events. Computes available_seats dynamically as capacity minus live registrations count."
          },
          "response": []
        },
        {
          "name": "2. GET Single Event by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1"]
            },
            "description": "Returns full details for event ID 1, or 404 if not found."
          },
          "response": []
        },
        {
          "name": "3. GET Non-Existent Event (Expected 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "9999"]
            },
            "description": "Validates that server correctly returns 404 Not Found when event ID does not exist."
          },
          "response": []
        },
        {
          "name": "4. POST Create Event (Stretch Goal)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"AI Robotics Hackathon\",\n  \"category\": \"Technical\",\n  \"description\": \"Build autonomous systems in 24 hours.\",\n  \"event_date\": \"2026-11-15\",\n  \"event_time\": \"09:00 AM\",\n  \"venue\": \"Innovation Lab\",\n  \"capacity\": 50,\n  \"fee\": 0,\n  \"icon\": \"🤖\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            },
            "description": "Admin endpoint to create a new event with server validation."
          },
          "response": []
        }
      ]
    },
